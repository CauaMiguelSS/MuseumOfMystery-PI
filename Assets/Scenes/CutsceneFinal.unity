  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableNote
  notePanel: {fileID: 0}
  noteTextUI: {fileID: 0}
  playerController: {fileID: 0}
  dialogueManager: {fileID: 0}
  noteText: "A Mona Lisa \xE9 uma das obras mais famosas de Leonardo da Vinci, pintada
    no in\xEDcio do s\xE9culo XVI. Conhecida pelo seu sorriso enigm\xE1tico e pelo
    uso do sfumato, a pintura demonstra a habilidade de Leonardo em representar detalhes,
    luz e express\xF5es humanas de forma realista."
  dialogueAfterClose: []
