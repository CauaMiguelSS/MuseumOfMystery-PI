  m_GameObject: {fileID: 7443600574211823601}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ed67cf75652b13c498ea01710fe31519, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableNote
  notePanel: {fileID: 4377567096887797189}
  noteTextUI: {fileID: 2623171069731581451}
  playerController: {fileID: 778861031898363231}
  dialogueManager: {fileID: 86011019}
  noteText: "Leonardo da Vinci dedicou parte de seus estudos \xE0 observa\xE7\xE3o
    de f\xF3sseis e forma\xE7\xF5es rochosas, buscando compreender como os restos
    de seres vivos poderiam estar presentes no interior das montanhas. Suas observa\xE7\xF5es
    ajudaram a questionar algumas ideias de sua \xE9poca sobre a origem dos f\xF3sseis
    e demonstraram seu interesse pela natureza e pela hist\xF3ria da Terra."
  dialogueAfterClose:
  - "Por mais que eu tenha interesse, f\xF3sseis n\xE3o era o meu foco."
  - "Nunca vi uma criatura t\xE3o grande quanto essa.."
