  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ed67cf75652b13c498ea01710fe31519, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableNote
  notePanel: {fileID: 4377567096887797189}
  noteTextUI: {fileID: 2623171069731581451}
  playerController: {fileID: 778861031898363231}
  dialogueManager: {fileID: 0}
  noteText: "Leonardo da Vinci desenvolveu estudos sobre uma m\xE1quina voadora conhecida
    como helic\xF3ptero de Da Vinci, tamb\xE9m chamada de parafuso a\xE9reo. Seu
    projeto consistia em uma estrutura com uma grande h\xE9lice em formato espiral,
    que giraria para tentar elevar o equipamento do ch\xE3o. Embora nunca tenha sido
    constru\xEDdo ou testado por ele, o projeto demonstrou sua criatividade e interesse
    em explorar novas possibilidades para o voo humano."
  dialogueAfterClose:
  - "da Vinci: Totalmente invi\xE1vel colocar esse prot\xF3tipo aqui."
  - "da Vinci: Fiquei desapontado quando percebi que n\xE3o funcionaria..."
