      m_Calls: []
  m_text: "A metralhadora de Leonardo da Vinci, tamb\xE9m conhecida como \xF3rg\xE3o
    de 33 canos, foi um projeto militar criado por Leonardo no s\xE9culo XV. Possu\xEDa
    v\xE1rios canos organizados em fileiras e poderia disparar v\xE1rios proj\xE9teis
    em sequ\xEAncia. Apesar de ter sido projetada para aumentar o poder de ataque,
    n\xE3o era uma metralhadora moderna e provavelmente nunca foi constru\xEDda ou
    utilizada por Leonardo."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8a74cf9e0290d794dad9ffde63387d26, type: 2}
  m_sharedMaterial: {fileID: -19813190911309673, guid: 8a74cf9e0290d794dad9ffde63387d26, type: 2}
