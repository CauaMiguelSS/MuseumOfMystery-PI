--- !u!114 &982397277348733273
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5387583520036287985}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ed67cf75652b13c498ea01710fe31519, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableNote
  interactText: {fileID: 7197025233714924000}
  notePanel: {fileID: 8063315265493075910}
  noteTextUI: {fileID: 6249035192672998257}
  noteText: "Per\xEDodo Jur\xE1ssico Superior (c. 155\u2013150 milh\xF5es de anos
    atr\xE1s)\nF\xF3ssil e reconstru\xE7\xE3o cient\xEDfica\n\nUm dos maiores predadores
    de seu tempo. Era um ca\xE7ador dominante nos ecossistemas do Jur\xE1ssico, provavelmente
    ca\xE7ando grandes herb\xEDvoros como saur\xF3podes.\n\nEstima-se que podia atingir
    at\xE9 12 metros de comprimento, sendo um dos maiores carn\xEDvoros terrestres
    da era jur\xE1ssica."
